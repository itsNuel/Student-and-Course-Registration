@model myproject.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1 class="page-title">Delete Enrollment</h1>

<p>Are you sure you want to delete this enrollment?</p>

<dl class="row">
    <dt class="col-sm-2">Student</dt>
    <dd class="col-sm-10">@Model.Student?.Name</dd>

    <dt class="col-sm-2">Course</dt>
    <dd class="col-sm-10">@Model.Course?.CourseName</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>