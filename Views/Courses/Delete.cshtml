@model myproject.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1 class="page-title">Delete Course</h1>
<h3>Are you sure you want to delete this course?</h3>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CourseCode)</dt>
    <dd class="col-sm-9">@Model.CourseCode</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CourseName)</dt>
    <dd class="col-sm-9">@Model.CourseName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Instructor)</dt>
    <dd class="col-sm-9">@Model.Instructor</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
