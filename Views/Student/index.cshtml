@model IEnumerable<myproject.Models.Student>

<h1>Students</h1>

<!-- Link to the Create page -->
<a asp-action="Create" class="btn btn-primary mb-3">
    Add Student
</a>

<table class="table">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Program</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Program</td>
            </tr>
        }

    </tbody>

</table>