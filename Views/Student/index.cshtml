@model IEnumerable<myproject.Models.Student>

<h1 class="page-title">Students</h1>

<table class="table student-list-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Program</th>
            <th>Email Address</th>
            <th>Phone Number</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Program</td>
                <td>@student.Email</td>
                <td>@student.Phone</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>