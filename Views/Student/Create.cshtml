@model myproject.ViewModels.StudentCreateViewModel

@{
    ViewData["Title"] = "Create Student";
    ViewData["PageClass"] = "create-page";
}

<h1 class="page-title">Create Student</h1>

<form id="studentForm" asp-controller="Student" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <span id="nameError" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Program" class="form-label"></label>
        <input asp-for="Program" class="form-control" />
        <span asp-validation-for="Program" class="text-danger"></span>
        <span id="programError" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" type="tel" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="create-form-actions">
        <button type="submit" class="btn btn-primary">Save Student</button>
        <a asp-controller="Student" asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("studentForm");

            form.addEventListener("submit", function (event) {
                const name = document.getElementById("Name").value.trim();
                const program = document.getElementById("Program").value.trim();

                const nameError = document.getElementById("nameError");
                const programError = document.getElementById("programError");

                nameError.textContent = "";
                programError.textContent = "";

                let isValid = true;
                const namePattern = /^[a-zA-Z\s'-]+$/;

                if (name === "") {
                    nameError.textContent = "Please enter the student's name.";
                    isValid = false;
                } else if (!namePattern.test(name)) {
                    nameError.textContent =
                        "Name must contain only letters, spaces, hyphens, or apostrophes.";
                    isValid = false;
                }

                const programPattern = /^[a-zA-Z0-9\s&()'-]+$/;

                if (program === "") {
                    programError.textContent = "Please enter the student's program.";
                    isValid = false;
                } else if (!programPattern.test(program)) {
                    programError.textContent = "Program contains invalid characters.";
                    isValid = false;
                } else if (!/[a-zA-Z]/.test(program)) {
                    programError.textContent = "Program must contain at least one letter.";
                    isValid = false;
                }

                if (!isValid) {
                    event.preventDefault();
                }
            });
        });
    </script>
}
